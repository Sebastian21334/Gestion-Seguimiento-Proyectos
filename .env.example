DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
APP_URL=http://localhost:3000
ACS_CONNECTION_STRING=endpoint=https://YOUR-RESOURCE.communication.azure.com/;accesskey=YOUR-KEY
ACS_SENDER_ADDRESS=DoNotReply@YOUR-VERIFIED-DOMAIN.azurecomm.net
SESSION_SECRET=replace-with-at-least-32-random-characters-for-session
EMAIL_TOKEN_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
# Separados por coma o punto y coma. Vacío permite cualquier dominio.
ALLOWED_EMAIL_DOMAINS=
# Activar solo si el proveedor sobrescribe este encabezado; Vercel lo hace.
TRUST_PROXY=false
